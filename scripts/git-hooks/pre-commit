#!/usr/bin/env bash
# Blocks commits that contain secrets, real-looking SSNs, key files, or large data files.
# Synthetic SSN-shaped values are allowed ONLY in the never-issued range (area 900-999, group 00).
set -euo pipefail
fail=0
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
# 1. secret scan (gitleaks if installed)
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --no-banner --log-level error || { echo "pre-commit: gitleaks found a possible secret"; fail=1; }
fi
# 2. forbidden file names
if echo "$staged" | grep -E '(^|/)(\.env($|\.[^e])|.*\.pem$|.*\.key$|.*\.p12$|credentials[^/]*$)' | grep -v '\.env\.example' >/dev/null; then
  echo "pre-commit: a secret-like file is staged"; fail=1; fi
# 3. SSN-shaped values outside the never-issued range (area 900-999 AND group 00 are the only allowed shape)
while IFS= read -r f; do
  [ -f "$f" ] || continue
  if git show ":$f" | grep -I -E -n '\b[0-8][0-9]{2}-[0-9]{2}-[0-9]{4}\b|\b9[0-9]{2}-(0[1-9]|[1-9][0-9])-[0-9]{4}\b' | head -3 | grep . >/dev/null; then
    echo "pre-commit: SSN-shaped value in the valid range found in $f (use the 9xx-00-xxxx synthetic range)"; fail=1; fi
done <<< "$staged"
# 4. large files (data does not belong in git): over 5 MB
while IFS= read -r f; do
  [ -f "$f" ] || continue
  sz=$(stat -c %s "$f"); [ "$sz" -gt 5242880 ] && { echo "pre-commit: $f is larger than 5 MB (data belongs outside git)"; fail=1; }
done <<< "$staged"
[ "$fail" -eq 0 ] || { echo "pre-commit: commit blocked"; exit 1; }
